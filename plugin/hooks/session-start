#!/usr/bin/env bash

HOOK_DIR="${BASH_SOURCE[0]%/*}"
if [[ "$HOOK_DIR" == "${BASH_SOURCE[0]}" ]]; then
  HOOK_DIR='.'
fi
ATCT_BIN="$HOOK_DIR/../bin/atct"
[[ -x "$ATCT_BIN" ]] || exit 0

CONTEXT_OUTPUT="$($ATCT_BIN context 2>/dev/null)" || exit 0
[[ -n "$CONTEXT_OUTPUT" ]] || exit 0

printf '%s\n' "$CONTEXT_OUTPUT"

/bin/cat <<'EOF'
This repository is registered with ATCT and is managed through ATCT.
Before starting work, declare your planned tasks with `atct_task_declare`, then claim one with `atct_task_claim`.
When a decision would change the shape of the work, do not guess: use `atct_decision_ask` with `wait_ms=0` to park.
Previous-session answers appear in `atct_goal_list` as `orphaned_decisions`; pass each `decision_id` to `atct_decision_poll` to continue.
When finished, call `atct_goal_complete` to request human approval.
See the `atct` skill for details.
EOF
