#!/usr/bin/env bash

INPUT="$(/bin/cat)"
STOP_HOOK_ACTIVE_RE='"stop_hook_active"[[:space:]]*:[[:space:]]*true'
if [[ "$INPUT" =~ $STOP_HOOK_ACTIVE_RE ]]; then
  exit 0
fi

HOOK_DIR="${BASH_SOURCE[0]%/*}"
if [[ "$HOOK_DIR" == "${BASH_SOURCE[0]}" ]]; then
  HOOK_DIR='.'
fi

version_gt() {
  local a b i
  local IFS=.
  local -a av=($1) bv=($2)
  for ((i = 0; i < ${#av[@]} || i < ${#bv[@]}; i++)); do
    a=${av[i]:-0}; b=${bv[i]:-0}
    ((10#$a > 10#$b)) && return 0
    ((10#$a < 10#$b)) && return 1
  done
  return 1
}

resolve_atct_bin() {
  local wrapper="$HOOK_DIR/../bin/atct"
  [[ -e "$wrapper" ]] || return 1

  local atct_bin_dir="${HOME:-}/.atct/bin"
  local candidate candidate_name version best="" best_version=""

  for candidate in "$atct_bin_dir"/atct-*; do
    [[ -x "$candidate" ]] || continue
    candidate_name="${candidate##*/}"
    [[ "$candidate_name" =~ ^atct-([0-9]+([.][0-9]+)+)$ ]] || continue
    version="${BASH_REMATCH[1]}"
    if [[ -z "$best" ]] || version_gt "$version" "$best_version"; then
      best="$candidate"; best_version="$version"
    fi
  done

  if [[ -n "$best" ]]; then
    printf '%s\n' "$best"
    return 0
  fi

  printf '%s\n' "$HOOK_DIR/../bin/atct"
}

ATCT_BIN="$(resolve_atct_bin)" || exit 0
[[ -x "$ATCT_BIN" ]] || exit 0

PENDING_OUTPUT="$($ATCT_BIN pending 2>/dev/null)" || exit 0
[[ -n "$PENDING_OUTPUT" ]] || exit 0

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

printf '{"decision":"block","reason":"%s"}\n' "$(json_escape "$PENDING_OUTPUT")"
