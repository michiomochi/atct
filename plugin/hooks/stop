#!/usr/bin/env bash

INPUT="$(/bin/cat)"
STOP_HOOK_ACTIVE_RE='"stop_hook_active"[[:space:]]*:[[:space:]]*true'
if [[ "$INPUT" =~ $STOP_HOOK_ACTIVE_RE ]]; then
  exit 0
fi

HOOK_DIR="${BASH_SOURCE[0]%/*}"
if [[ "$HOOK_DIR" == "${BASH_SOURCE[0]}" ]]; then
  HOOK_DIR='.'
fi

resolve_atct_bin() {
  local atct_bin_dir="${HOME:-}/.atct/bin"
  local candidate candidate_name
  local -a versioned_bins=()

  for candidate in "$atct_bin_dir"/atct-*; do
    [[ -x "$candidate" ]] || continue
    candidate_name="${candidate##*/}"
    [[ "$candidate_name" =~ ^atct-[0-9]+([.][0-9]+)+$ ]] || continue
    versioned_bins+=("$candidate")
  done

  if ((${#versioned_bins[@]} > 0)); then
    printf '%s\n' "${versioned_bins[@]}" | sort -V | tail -n 1
    return 0
  fi

  printf '%s\n' "$HOOK_DIR/../bin/atct"
}

ATCT_BIN="$(resolve_atct_bin)"
[[ -x "$ATCT_BIN" ]] || exit 0

PENDING_OUTPUT="$($ATCT_BIN pending 2>/dev/null)" || exit 0
[[ -n "$PENDING_OUTPUT" ]] || exit 0

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

printf '{"decision":"block","reason":"%s"}\n' "$(json_escape "$PENDING_OUTPUT")"
