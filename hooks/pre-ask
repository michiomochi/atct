#!/usr/bin/env bash

INPUT="$(/bin/cat)"
TOOL_NAME_RE='"tool_name"[[:space:]]*:[[:space:]]*"([^"]*)"'
[[ "$INPUT" =~ $TOOL_NAME_RE ]] || exit 0
[[ "${BASH_REMATCH[1]}" == "AskUserQuestion" ]] || exit 0

CWD_RE='"cwd"[[:space:]]*:[[:space:]]*"([^"]*)"'
[[ "$INPUT" =~ $CWD_RE ]] || exit 0
CWD="${BASH_REMATCH[1]}"

HOOK_DIR="${BASH_SOURCE[0]%/*}"
if [[ "$HOOK_DIR" == "${BASH_SOURCE[0]}" ]]; then
  HOOK_DIR='.'
fi
HOOK_DIR="$(cd -- "$HOOK_DIR" && pwd -P)" || exit 0

if ! command -v atct >/dev/null 2>&1; then
  printf '%s\n' 'ATCT: install or upgrade the CLI with: brew install --cask michiomochi/tap/atct' >&2
  exit 0
fi

PLUGIN_VERSION="$(awk -F '"' '/"version"[[:space:]]*:/ { print $4; exit }' "$HOOK_DIR/../.claude-plugin/plugin.json" 2>/dev/null)"
INSTALLED_VERSION="$(atct version 2>/dev/null || true)"
if [[ -z "$PLUGIN_VERSION" || -z "$INSTALLED_VERSION" ]] || ! awk -v installed="$INSTALLED_VERSION" -v required="$PLUGIN_VERSION" '
  BEGIN {
    split(installed, have, ".")
    split(required, need, ".")
    for (i = 1; i <= 3; i++) {
      if (have[i] + 0 > need[i] + 0) exit 0
      if (have[i] + 0 < need[i] + 0) exit 1
    }
    exit 0
  }
'; then
  printf '%s\n' 'ATCT: upgrade the CLI with: brew upgrade --cask michiomochi/tap/atct' >&2
  exit 0
fi

[[ -d "$CWD" ]] || exit 0

(
  cd -- "$CWD" || exit 0
  CONTEXT_OUTPUT="$(atct context 2>/dev/null)" || exit 0
  [[ -n "$CONTEXT_OUTPUT" ]] || exit 0
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"atct_decision_ask: include at least two options and state the consequence of each (option A: continue with the first path; option B: continue with the second path). For reversible choices, execute first, record wait_ms=0, and do not wait. For irreversible choices, omit default_option and wait."}}'
)
