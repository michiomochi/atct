#!/usr/bin/env bash

HOOK_DIR="${BASH_SOURCE[0]%/*}"
if [[ "$HOOK_DIR" == "${BASH_SOURCE[0]}" ]]; then
  HOOK_DIR='.'
fi
HOOK_DIR="$(cd -- "$HOOK_DIR" && pwd -P)" || exit 0
ATCT_BIN="$HOOK_DIR/../bin/atct"
if [[ ! -x "$ATCT_BIN" ]]; then
  printf '%s\n' '{"decision":"block","reason":"ATCT stop-check failed: command unavailable"}'
  exit 0
fi

"$ATCT_BIN" stop-check --hook-input
exit 0
