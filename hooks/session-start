#!/usr/bin/env bash

HOOK_DIR="${BASH_SOURCE[0]%/*}"
if [[ "$HOOK_DIR" == "${BASH_SOURCE[0]}" ]]; then
  HOOK_DIR='.'
fi
HOOK_DIR="$(cd -- "$HOOK_DIR" && pwd -P)" || exit 0
ATCT_BIN="$HOOK_DIR/../bin/atct"
[[ -x "$ATCT_BIN" ]] || exit 0

CONTEXT_OUTPUT="$($ATCT_BIN context -brief 2>/dev/null)"
CONTEXT_STATUS=$?
if [[ "$CONTEXT_STATUS" -eq 3 ]]; then
  printf '%s\n' "ATCT: this session's atct cannot open the database (it predates a release). Restart the session." >&2
  exit 0
fi
[[ "$CONTEXT_STATUS" -eq 0 ]] || exit 0
[[ -n "$CONTEXT_OUTPUT" ]] || exit 0

if DAEMON_START_OUTPUT="$($ATCT_BIN daemon start 2>&1)"; then
  if [[ "$DAEMON_START_OUTPUT" =~ http[[:space:]]+([^[:space:]]+) ]]; then
    DAEMON_HTTP_ADDR="${BASH_REMATCH[1]}"
    if [[ "$DAEMON_HTTP_ADDR" != "127.0.0.1:8787" ]]; then
      printf 'ATCT warning: daemon is listening at %s; MCP endpoint is fixed at http://127.0.0.1:8787/mcp.\n' "$DAEMON_HTTP_ADDR" >&2
    fi
  fi
fi

printf '%s\n' "$CONTEXT_OUTPUT"
