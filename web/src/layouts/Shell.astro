---
import "../styles/global.css";
import { LocaleSwitch } from "../components/LocaleSwitch";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Review ATCT tasks and decisions." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | ATCT</title>
  </head>
  <body>
    <header class="border-b border-line bg-surface">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 lg:px-8">
        <a class="focus-ring font-display text-base font-semibold text-ink-950" href="/">
          ATCT
        </a>
        <nav class="flex items-center gap-4" aria-label="Main navigation">
          <LocaleSwitch client:load />
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-7xl px-5 py-8 lg:px-8 lg:py-10">
      <slot />
    </main>
  </body>
</html>
