#!/usr/bin/env bash
set -euo pipefail

VERSION="0.61.1"
RELEASE_BASE="https://github.com/michiomochi/atct/releases/download/v${VERSION}"

fail() {
  printf 'atct: %s\n' "$*" >&2
  exit 1
}

if [[ $# -lt 1 ]]; then
  fail 'internal wrapper error: a binary name is required. Reload or reinstall the atct plugin and retry.'
fi

BINARY_NAME="$1"
shift

case "$BINARY_NAME" in
  atct|atct-mcp) ;;
  *) fail "internal wrapper error: unsupported binary <$BINARY_NAME>. Reload or reinstall the atct plugin and retry." ;;
esac

ATCT_WRAPPER="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/atct"

HOME_DIR="${HOME:-}"
[[ -n "$HOME_DIR" ]] || fail 'HOME is not set, so the downloaded binary cannot be cached. Set HOME and retry.'

GLOBAL_LAUNCHER_DIR="$HOME_DIR/.local/bin"
GLOBAL_LAUNCHER="$GLOBAL_LAUNCHER_DIR/atct"
GLOBAL_LAUNCHER_MARKER='ATCT_GLOBAL_LAUNCHER_V1'

ensure_terminal_launcher() {
  if ! mkdir -p -- "$GLOBAL_LAUNCHER_DIR"; then
    fail "Could not create the stable atct launcher directory <$GLOBAL_LAUNCHER_DIR>. Check its permissions and retry."
  fi

  if [[ -e "$GLOBAL_LAUNCHER" || -L "$GLOBAL_LAUNCHER" ]]; then
    if [[ -L "$GLOBAL_LAUNCHER" ]]; then
      fail "Refusing to replace symlink <$GLOBAL_LAUNCHER>. Remove it or choose another launcher path and retry."
    fi
    if [[ -d "$GLOBAL_LAUNCHER" ]]; then
      fail "Refusing to replace directory <$GLOBAL_LAUNCHER>. Remove it or choose another launcher path and retry."
    fi
    if [[ ! -f "$GLOBAL_LAUNCHER" ]]; then
      fail "Refusing to replace non-regular file <$GLOBAL_LAUNCHER>. Remove it or choose another launcher path and retry."
    fi
    if ! grep -Fxq -- "# $GLOBAL_LAUNCHER_MARKER" "$GLOBAL_LAUNCHER"; then
      fail "Refusing to replace unmarked file <$GLOBAL_LAUNCHER>. Remove it or choose another launcher path and retry."
    fi
  fi

  local launcher_tmp
  local wrapper_literal
  if ! launcher_tmp="$(mktemp "$GLOBAL_LAUNCHER_DIR/.atct-launcher.XXXXXX")"; then
    fail "Could not create a temporary stable atct launcher in <$GLOBAL_LAUNCHER_DIR>. Check its permissions and retry."
  fi

  printf -v wrapper_literal '%q' "$ATCT_WRAPPER"
  if ! {
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'set -euo pipefail'
    printf '%s\n' "# $GLOBAL_LAUNCHER_MARKER"
    printf 'ATCT_WRAPPER=%s\n' "$wrapper_literal"
    printf '%s\n' 'exec "$ATCT_WRAPPER" "$@"'
  } >"$launcher_tmp"; then
    rm -f -- "$launcher_tmp" 2>/dev/null || true
    fail "Could not write the stable atct launcher in <$GLOBAL_LAUNCHER_DIR>. Check its permissions and retry."
  fi
  if ! chmod 0755 "$launcher_tmp"; then
    rm -f -- "$launcher_tmp" 2>/dev/null || true
    fail "Could not make the stable atct launcher executable in <$GLOBAL_LAUNCHER_DIR>. Check its permissions and retry."
  fi
  if ! mv -f -- "$launcher_tmp" "$GLOBAL_LAUNCHER"; then
    rm -f -- "$launcher_tmp" 2>/dev/null || true
    fail "Could not install the stable atct launcher at <$GLOBAL_LAUNCHER>. Check its permissions and retry."
  fi
}

ensure_terminal_launcher

CACHE_DIR="$HOME_DIR/.atct/bin"
CACHED_BINARY="$CACHE_DIR/${BINARY_NAME}-${VERSION}"
CACHE_TTL_DAYS=14

if ! mkdir -p "$CACHE_DIR"; then
  fail "Could not create the cache directory <$CACHE_DIR>. Check its permissions and retry."
fi

TEMP_DIR=''
cleanup() {
  if [[ -n "$TEMP_DIR" && -e "$TEMP_DIR" ]]; then
    rm -rf -- "$TEMP_DIR"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

find "$CACHE_DIR" -maxdepth 1 -type d -name '.download.*' -mmin +60 -exec rm -rf -- {} + 2>/dev/null || true
find "$CACHE_DIR" -maxdepth 1 -type f ! -name "*-${VERSION}" -mmin +$((CACHE_TTL_DAYS * 1440)) -exec rm -f -- {} + 2>/dev/null || true

if [[ -x "$CACHED_BINARY" ]]; then
  touch "$CACHED_BINARY" 2>/dev/null || true
  export ATCT_ATCT_BIN="$ATCT_WRAPPER"
  exec "$CACHED_BINARY" "$@"
fi

if ! command -v curl >/dev/null 2>&1; then
  fail "curl is required to download ATCT. Install curl with your operating system's package manager and retry."
fi

if ! KERNEL="$(uname -s 2>/dev/null)"; then
  fail 'The operating system could not be determined. Run the plugin on a supported system and retry.'
fi
case "$KERNEL" in
  Darwin) OS="darwin" ;;
  Linux) OS="linux" ;;
  *) fail "Unsupported platform <$KERNEL>. The ATCT plugin supports macOS and Linux only." ;;
esac

if ! MACHINE="$(uname -m 2>/dev/null)"; then
  fail 'The CPU architecture could not be determined. Run the plugin on a supported architecture and retry.'
fi
case "$MACHINE" in
  x86_64|amd64) ARCH="amd64" ;;
  arm64|aarch64) ARCH="arm64" ;;
  *) fail "Unsupported architecture <$MACHINE>. The ATCT plugin supports amd64 and arm64 only." ;;
esac

if command -v shasum >/dev/null 2>&1; then
  CHECKSUM_TOOL='shasum'
elif command -v sha256sum >/dev/null 2>&1; then
  CHECKSUM_TOOL='sha256sum'
else
  fail "SHA-256 verification requires shasum or sha256sum, but neither is available. Install one with your operating system's package manager and retry."
fi

ARCHIVE_NAME="atct_${VERSION}_${OS}_${ARCH}.tar.gz"
ARCHIVE_URL="${RELEASE_BASE}/${ARCHIVE_NAME}"
CHECKSUMS_URL="${RELEASE_BASE}/checksums.txt"

if ! TEMP_DIR="$(mktemp -d "$CACHE_DIR/.download.XXXXXX")"; then
  fail "Could not create a temporary download directory in <$CACHE_DIR>. Check its permissions and retry."
fi

ARCHIVE_PATH="$TEMP_DIR/$ARCHIVE_NAME"
CHECKSUMS_PATH="$TEMP_DIR/checksums.txt"

if ! curl --fail --location --silent --show-error --output "$ARCHIVE_PATH" "$ARCHIVE_URL"; then
  fail "Could not download <$ARCHIVE_NAME> from GitHub Releases. Check your network connection and retry."
fi
if ! curl --fail --location --silent --show-error --output "$CHECKSUMS_PATH" "$CHECKSUMS_URL"; then
  fail 'Could not download checksums.txt from GitHub Releases. Check your network connection and retry.'
fi

EXPECTED_CHECKSUM="$(awk -v target="$ARCHIVE_NAME" '
  {
    filename = $2
    sub(/^\*/, "", filename)
    if (filename == target) {
      print tolower($1)
      exit
    }
  }
' "$CHECKSUMS_PATH")"
[[ -n "$EXPECTED_CHECKSUM" ]] || fail "checksums.txt does not contain <$ARCHIVE_NAME>; the release metadata is incomplete. Retry later."

if [[ "$CHECKSUM_TOOL" == shasum ]]; then
  if ! ACTUAL_CHECKSUM="$(shasum -a 256 "$ARCHIVE_PATH" | awk '{print tolower($1)}')"; then
    fail "Could not calculate the SHA-256 checksum for <$ARCHIVE_NAME>. Install a working shasum or sha256sum and retry."
  fi
else
  if ! ACTUAL_CHECKSUM="$(sha256sum "$ARCHIVE_PATH" | awk '{print tolower($1)}')"; then
    fail "Could not calculate the SHA-256 checksum for <$ARCHIVE_NAME>. Install a working shasum or sha256sum and retry."
  fi
fi

if [[ "$ACTUAL_CHECKSUM" != "$EXPECTED_CHECKSUM" ]]; then
  fail "Checksum verification failed for <$ARCHIVE_NAME>: expected <$EXPECTED_CHECKSUM>, got <$ACTUAL_CHECKSUM>. The download was not executed. Retry later."
fi

if ! tar -xzf "$ARCHIVE_PATH" -C "$TEMP_DIR" "$BINARY_NAME"; then
  fail "Could not extract <$BINARY_NAME> from <$ARCHIVE_NAME>. The release archive may be incomplete; retry later."
fi
[[ -f "$TEMP_DIR/$BINARY_NAME" ]] || fail "The verified archive did not contain <$BINARY_NAME>. The release archive is incomplete; retry later."

if ! chmod +x "$TEMP_DIR/$BINARY_NAME"; then
  fail "Could not make the downloaded <$BINARY_NAME> executable. Check permissions for <$CACHE_DIR> and retry."
fi
if ! mv "$TEMP_DIR/$BINARY_NAME" "$CACHED_BINARY"; then
  fail "Could not cache <$BINARY_NAME> in <$CACHE_DIR>. Check permissions and retry."
fi

cleanup
export ATCT_ATCT_BIN="$ATCT_WRAPPER"
exec "$CACHED_BINARY" "$@"
